    <worksheet name='6. Root Cause: Disc Vs PM'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ff1493' fontname='Segoe UI' fontsize='10'>Root cause: Impact of Discount on Profit Margin</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffb300' fontname='Segoe UI' fontsize='8'>0% discount → +29.5% profit margin | Break-even near 20% discount | 30% discount → –16.5% profit margin</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='raw_data (raw_data_SampleSuperstore.csv)' name='federated.0wh6ns01njkgdx14ri9wf0gb5j5b' />
          </datasources>
          <datasource-dependencies datasource='federated.0wh6ns01njkgdx14ri9wf0gb5j5b'>
            <column caption='Profit Margin %' datatype='real' default-format='p0.0%' name='[Calculation_1448888322596864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( SUM([Profit]) / SUM([Sales]) )' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column aggregation='None' caption='Discount (bin) 2' datatype='integer' name='[Discount (bin) 2]' role='dimension' type='quantitative'>
              <calculation class='bin' decimals='-1' formula='[Discount]' peg='0' size='0.1' />
            </column>
            <column datatype='real' default-format='p0%' name='[Discount]' role='measure' type='quantitative' />
            <column datatype='real' default-format='c&quot;$&quot;#,##0,K' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='real' default-format='c&quot;$&quot;#,##0,K' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Discount]' derivation='Avg' name='[avg:Discount:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Discount (bin) 2]' derivation='None' name='[none:Discount (bin) 2:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1448888322596864]' derivation='User' name='[usr:Calculation_1448888322596864:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0wh6ns01njkgdx14ri9wf0gb5j5b].[Action (Country,State)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action1_E75DB4D73D384CD3A4E217F896024BCC]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Country]' />
              <groupfilter function='level-members' level='[State]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0wh6ns01njkgdx14ri9wf0gb5j5b].[none:Discount (bin) 2:ok]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Discount (bin) 2:ok]' />
              <groupfilter function='member' level='[none:Discount (bin) 2:ok]' member='2' />
            </groupfilter>
          </filter>
