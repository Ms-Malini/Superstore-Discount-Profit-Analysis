              <calculation class='tableau' formula='IF [Discount] = 0 THEN &quot;No Discount&quot;&#13;&#10;ELSEIF [Discount] &gt; 0 AND [Discount] &lt;= 0.20 THEN &quot;Low (0-20%)&quot;&#13;&#10;ELSEIF [Discount] &gt; 0.20 AND [Discount] &lt;= 0.40 THEN &quot;Medium (20-40%)&quot;&#13;&#10;ELSE &quot;High (40%+)&quot;&#13;&#10;END' />
