      <aliases enabled='yes' />
      <column caption='Discount color category' datatype='string' name='[Calculation_1022829563228160]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([Discount]) &gt; 0.20 THEN &quot;High Risk Discount&quot;&#13;&#10;ELSEIF AVG([Discount]) &gt;= 0.15 AND AVG([Discount]) &lt;= 0.19 THEN &quot;Moderate Discount&quot;&#13;&#10;ELSE &quot;Healthy Discount&quot;&#13;&#10;END' />
      </column>
      <column caption='Discount_band' datatype='string' name='[Calculation_1022829571571713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount] = 0 THEN &quot;No Discount&quot;&#13;&#10;ELSEIF [Discount] &gt; 0 AND [Discount] &lt;= 0.20 THEN &quot;Low (0-20%)&quot;&#13;&#10;ELSEIF [Discount] &gt; 0.20 AND [Discount] &lt;= 0.40 THEN &quot;Medium (20-40%)&quot;&#13;&#10;ELSE &quot;High (40%+)&quot;&#13;&#10;END' />
      </column>
      <column caption='Profit Margin %' datatype='real' default-format='p0.0%' name='[Calculation_1448888322596864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM([Profit]) / SUM([Sales]) )' />
      </column>
      <column caption='Threshold' datatype='real' name='[Calculation_2211676111323136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.2' />
      </column>
      <column caption='profit status' datatype='string' name='[Calculation_2211676166320134]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &lt; 0 THEN &quot;Loss&quot;&#13;&#10;ELSE &quot;Profit&quot;&#13;&#10;END' />
      </column>
      <column caption='Avg Discount%' datatype='real' default-format='p0.0%' name='[Calculation_2211676212957191]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Discount])' />
      </column>
      <column caption='Profit Status_1' datatype='string' name='[Calculation_2211676213514248]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &lt; 0 THEN &quot;Loss&quot;&#13;&#10;ELSE &quot;Profit&quot;&#13;&#10;END' />
      </column>
      <column caption='Discount Visual' datatype='real' default-format='p0.0%' name='[Calculation_2211676217974793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Discount]) * 100' />
      </column>
